---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { excerpt } from "@lib/utils";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro";
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro";

// Create the static blog pages
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    return {
      params: { slug: post.id },
      props: post,
    };
  });
}

// Get the requested post
type Props = CollectionEntry<"blog">;
const post = Astro.props;
const { title, external } = post.data;

// external posts are a stub page pointing at the original, so there's no body to summarise
const description =
  post.data.description ||
  (external ? `Published on ${external.name}` : excerpt(post.body ?? "")) ||
  undefined;

// set by the `remarkHasMath` plugin on posts that actually render math
const { remarkPluginFrontmatter } = await render(post);
const hasMath = Boolean(remarkPluginFrontmatter.hasMath);
---

<PageLayout title={title} description={description} hasMath={hasMath}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={post} />
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={post} />
    </div>
  </BottomLayout>
</PageLayout>
